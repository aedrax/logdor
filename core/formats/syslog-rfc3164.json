{
    "id": "syslog-rfc3164",
    "displayName": "Syslog (RFC 3164)",
    "pattern": "^(?<time>[A-Z][a-z]{2}\\s+\\d{1,2} \\d{2}:\\d{2}:\\d{2}) (?<host>\\S+) (?<proc>[^\\[:]+)(?:\\[(?<pid>\\d+)\\])?: ?(?<msg>.*)$",
    "fields": [
        { "name": "Time", "capture": "time", "type": "datetime", "hint": "timestamp" },
        { "name": "Host", "capture": "host", "type": "string", "hint": "identifier" },
        { "name": "Process", "capture": "proc", "type": "string", "hint": "identifier" },
        { "name": "PID", "capture": "pid", "type": "integer", "hint": "numeric" },
        { "name": "Message", "capture": "msg", "type": "string", "hint": "message" }
    ],
    "specificity": 0.85
}
