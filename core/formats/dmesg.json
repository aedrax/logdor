{
    "id": "dmesg",
    "displayName": "Kernel ring buffer (dmesg)",
    "pattern": "^\\[\\s*(?<time>\\d+\\.\\d+)\\]\\s(?<msg>.*)$",
    "fields": [
        { "name": "Time", "capture": "time", "type": "datetime", "hint": "timestamp", "timeFormat": "uptime" },
        { "name": "Message", "capture": "msg", "type": "string", "hint": "message" }
    ],
    "specificity": 0.9
}
