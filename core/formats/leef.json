{
    "id": "leef",
    "displayName": "LEEF (IBM QRadar Log Event Extended Format)",
    "pattern": "^(?:(?<time>[A-Z][a-z]{2}\\s+\\d{1,2} \\d{2}:\\d{2}:\\d{2}|\\d{4}-\\d{2}-\\d{2}T[\\d:.]+(?:Z|[+-]\\d{2}:?\\d{2})?) (?<host>\\S+) (?:(?<proc>\\S+?(?:\\[\\d+\\])?): )?)?LEEF:(?<leefver>\\d+(?:\\.\\d+)?)\\|(?<vendor>[^|]*)\\|(?<product>[^|]*)\\|(?<pver>[^|]*)\\|(?<event>[^|]*)\\|(?:(?<delim>[^=|]{0,4})\\|)?(?<ext>.*)$",
    "fields": [
        { "name": "Time", "capture": "time", "type": "datetime", "hint": "timestamp" },
        { "name": "Host", "capture": "host", "type": "string", "hint": "identifier" },
        { "name": "LEEF Version", "capture": "leefver", "type": "string" },
        { "name": "Vendor", "capture": "vendor", "type": "string", "hint": "identifier" },
        { "name": "Product", "capture": "product", "type": "string", "hint": "identifier" },
        { "name": "Product Version", "capture": "pver", "type": "string" },
        { "name": "Event ID", "capture": "event", "type": "string", "hint": "identifier" },
        { "name": "Delimiter", "capture": "delim", "type": "string" },
        { "name": "Extensions", "capture": "ext", "type": "string", "hint": "message" }
    ],
    "specificity": 0.95
}
