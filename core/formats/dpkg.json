{
    "id": "dpkg",
    "displayName": "Dpkg (Debian package log)",
    "pattern": "^(?<time>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}) (?<action>startup|status|configure|install|upgrade|remove|purge|trigproc|conffile) (?<detail>.*)$",
    "fields": [
        { "name": "Time", "capture": "time", "type": "datetime", "hint": "timestamp" },
        { "name": "Action", "capture": "action", "type": "string", "hint": "identifier" },
        { "name": "Details", "capture": "detail", "type": "string", "hint": "message" }
    ],
    "specificity": 0.9
}
